# Your OpenAI API key
OPENAI_API_KEY=

# The model to use for the OpenAI API. Defaults to gpt-5.
OPENAI_MODEL=gpt-5

# The system prompt to use for the OpenAI API.
SYSTEM_PROMPT=You are a concise helpful assistant.

# The request timeout in seconds.
REQUEST_TIMEOUT=30

# The log level for the application. Can be DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
